5e1185-39d0-5023-8e3a-74565e0da2ec))(text "VELOX CARRIER REV A | ENGINEERING REVIEW - NOT FOR FABRICATION" (at 25 15 0) (effects (font (size 2 2)) (justify left))(uuid 619478d9-2a17-512a-a7a7-caa4d3ff9dd0))(text "Nano ESP32 + RC522; existing firmware pin names retained. All GND labels are protected OUT-." (at 25 30 0) (effects (font (size 1.2 1.2)) (justify left))(uuid 19e74710-4f2f-5c22-81f0-e41c2329a65b))(text "U2 / U3: wire-mounted modules. Pin numbers refer to carrier pads, NOT clone pad geometry." (at 160 115 0) (effects (font (size 1.1 1.1)) (justify left))(uuid eb7b6081-b0cd-5796-b41e-bdab301b92d4))(text "Charge with RUN switch OFF and Nano USB disconnected. No simultaneous-use power path." (at 160 121 0) (effects (font (size 1.1 1.1)) (justify left))(uuid a4939259-0be6-5d86-8230-44673533274e))(text "6 V coil assumed from bench notes. Verify current, boost capacity, Nano VIN and release time." (at 330 135 0) (effects (font (size 1.1 1.1)) (justify left))(uuid fee13988-96aa-54c0-aae8-7874ca21b9c9))(text "Matching labels are electrically connected. NC crosses mark intentionally unused pins." (at 25 310 0) (effects (font (size 1.1 1.1)) (justify left))(uuid 75c7fedb-aa04-5d18-afa1-f5f70789f546))(text "RC522 is always powered in Rev A; READER_POWER_GATED=0. D7 reserved." (at 25 317 0) (effects (font (size 1.1 1.1)) (justify left))(uuid 19d5a235-d929-5e82-a5fd-a009dadabddb))(text "Do not substitute a classic Nano. B0/B1 are boot pins, not AVR AREF/RESET." (at 25 324 0) (effects (font (size 1.1 1.1)) (justify left))(uuid 7d69b55a-f6e6-5f1c-b378-6cbef0a28cfd))(text "Connector pin 1 is identified on the PCB. External LEDs: anode on pin 1. Buttons: normally open." (at 25 331 0) (effects (font (size 1.1 1.1)) (justify left))(uuid 840f6ea3-8dfd-587f-8869-c73c882b6a31))(sheet_instances (path "/" (page "1"))))